{
  "name": "kontas-download",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "postinstall": "node -e \"try{require('./scripts/ensure-local-extensions.cjs')}catch(e){}\"",
    "predev": "node scripts/ensure-local-extensions.cjs",
    "dev": "next dev -p 3200",
    "prebuild": "node scripts/ensure-local-extensions.cjs",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "eslint",
    "pretest": "node scripts/ensure-local-extensions.cjs",
    "test": "node --test tests/*.cjs",
    "rules:audit": "node scripts/rules-audit.cjs"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "pdfmake": "^0.3.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "xmllint-wasm": "^5.3.0"
  }
