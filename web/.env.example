# Relative paths are resolved from the web working directory.
DATABASE_URL="file:./prisma/dev.db"
# Set the externally visible origin when using a reverse proxy.
APP_ORIGIN="http://localhost:3200"
# Local HTTP only. Use true in HTTPS production.
COOKIE_SECURE=false
# The port (3200) is set in the package.json scripts "dev" and "start"; Next.js does not read PORT from .env.
# SMTP is configured separately in each company card.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key when restoring the database; changing it invalidates stored SMTP passwords.
SMTP_ENCRYPTION_KEY=
