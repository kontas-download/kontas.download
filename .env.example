# Copy this file to .env (same folder as docker-compose.yml) and fill it in. Never share or publish .env.

# Encrypts the SMTP passwords stored in the database. Generate once, for example:
#   openssl rand -hex 32
# Keep a copy somewhere safe and separate from the database backups: without it stored SMTP passwords cannot be decrypted.
SMTP_ENCRYPTION_KEY=

# Used only the first time, when the database does not exist yet. Leave ADMIN_PASSWORD empty to get a random one-time
# password in the container log ("docker logs kontas-app"). Minimum 10 characters.
ADMIN_EMAIL=admin@kontas.local
ADMIN_PASSWORD=

# Address in the browser. Change it together with the port in docker-compose.yml, or when you open the program through a domain.
APP_ORIGIN=http://localhost:3200
# true only when the program is served over HTTPS (see deploy/README.md).
COOKIE_SECURE=false
