# Public domain name pointing at this server (DNS A/AAAA record). Caddy gets the HTTPS certificate for it automatically.
DOMAIN=accounting.example.com

# Encrypts the SMTP passwords stored in the database. Generate once:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep a copy somewhere safe and separate from the database backups: without it stored SMTP passwords cannot be decrypted.
SMTP_ENCRYPTION_KEY=

# Used only the first time, when the database does not exist yet. Leave ADMIN_PASSWORD empty to get a random one-time
# password in the container log ("docker logs kontas-app"). Minimum 10 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
